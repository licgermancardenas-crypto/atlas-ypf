		dataType: string
		isHidden
		lineageTag: e7bdf8f3-8cb5-53b7-967d-ee8621370c43
		summarizeBy: none
		sourceColumn: Comparacion

		annotation SummarizationSetBy = User

	column Componente
		dataType: string
		isHidden
		lineageTag: 2bbbaa07-33bf-5683-b93e-64d1cba7ae82
		summarizeBy: none
		sourceColumn: Componente

