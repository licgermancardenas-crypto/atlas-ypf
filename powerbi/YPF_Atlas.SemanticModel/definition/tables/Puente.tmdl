	column Orden
		dataType: int64
		isHidden
		lineageTag: e81cbc6c-28a7-5d43-a1dc-5aa371810aa1
		summarizeBy: none
		sourceColumn: Orden

		annotation SummarizationSetBy = User

	partition Puente = m
		mode: import
		source =
				let
				    Fuente = Parquet.Document(File.Contents(RutaDatos & "ebitda_puente.parquet")),
				    Largo = Table.UnpivotOtherColumns(
				        Table.SelectColumns(Fuente, {"periodo", "comparacion", "volumen_musd", "precio_musd", "costo_musd", "otros_negocios_musd", "administracion_musd", "consolidacion_musd", "ajustes_musd"}),
				        {"periodo", "comparacion"}, "campo", "ValorMUSD"),
				    Nombres = Table.AddColumn(Largo, "Componente", each
				        Record.FieldOrDefault(
				            [volumen_musd = "Volumen", precio_musd = "Precio", costo_musd = "Costo", otros_negocios_musd = "Otros negocios", administracion_musd = "Administración", consolidacion_musd = "Consolidación", ajustes_musd = "Ajustes de la compañía"], [campo], [campo]), type text),
				    ConOrden = Table.NestedJoin(Nombres, {"periodo"}, Trimestres, {"Codigo"}, "T", JoinKind.Inner),
				    Expandido = Table.ExpandTableColumn(ConOrden, "T", {"Orden"}),
				    Renombrado = Table.RenameColumns(Table.RemoveColumns(Expandido, {"periodo", "campo"}), {{"comparacion", "Comparacion"}}),
				    Final = Table.TransformColumnTypes(Renombrado, {{"ValorMUSD", type number}, {"Orden", Int64.Type}, {"Comparacion", type text}})
				in
				    Final

