	measure 'Variación precio del crudo' =
			VAR a = [Precio del crudo]
			VAR b = CALCULATE([Precio del crudo], TREATAS({[_Trimestres comparación]}, Desfase[N]))
			RETURN
			    IF(NOT ISBLANK(a) && NOT ISBLANK(b) && b <> 0, (a - b) / ABS(b))
		formatString: """▲ ""0.0%;""▼ ""0.0%;""–"""
		displayFolder: Operativo
		lineageTag: bc69a495-d30a-54fa-a6c9-e40b25aa5e94

